+#ifdef MIXXX_USE_QML
+namespace {
+
+// Full frame every N frames even when nothing changed, so a lost transfer
+// never leaves a display stale for long (7.5 s at 20 fps).
+constexpr uint kNativeFullRefreshFrames = 150;
+
+// Traktor Kontrol S8 display frame, format from kontrol-s8-protocol
+// (CC-BY-4.0): 16-byte header, runs of RGB565 pixel pairs, 8-byte footer.
+// Run commands (op, 0, count hi, count lo): 0x00 literal pairs follow,
+// 0x01 one pair repeated count times, 0x02 skip count pairs (the display
+// keeps what it shows). With `previous`, unchanged pairs become skips, so a
+// frame where only the waveform moves is a few KB instead of 261 KB.
+QByteArray encodeKontrolS8Frame(int screen,
+        const QByteArray& pixels,
+        const QByteArray& previous,
+        int width,
+        int height) {
+    const int pairs = width * height / 2;
+    const auto* cur = reinterpret_cast<const quint32*>(pixels.constData());
+    const quint32* prev = previous.size() == pixels.size()
+            ? reinterpret_cast<const quint32*>(previous.constData())
+            : nullptr;
+    constexpr int kMaxRun = 0xFFFF;
+
+    QByteArray out;
+    out.reserve(16 + 8 + 4096);
+    auto byte = [&out](int value) { out.append(static_cast<char>(value & 0xFF)); };
+    auto command = [&byte](int op, int count) {
+        byte(op);
+        byte(0);
+        byte(count >> 8);
+        byte(count);
+    };
+    auto unchanged = [cur, prev](int index) { return prev && cur[index] == prev[index]; };
+
+    for (int value : {0x84, 0, screen, 0x60, 0, 0, 0, 0, 0, 0, 0, 0}) {
+        byte(value);
+    }
+    byte(width >> 8);
+    byte(width);
+    byte(height >> 8);
+    byte(height);
+
+    int i = 0;
+    while (i < pairs) {
+        if (unchanged(i)) {
+            int j = i + 1;
+            while (j < pairs && unchanged(j) && j - i < kMaxRun) {
+                ++j;
+            }
+            command(0x02, j - i);
+            i = j;
+            continue;
+        }
+        int j = i + 1;
+        while (j < pairs && cur[j] == cur[i] && !unchanged(j) && j - i < kMaxRun) {
+            ++j;
+        }
+        if (j - i >= 2) {
+            command(0x01, j - i);
+            out.append(reinterpret_cast<const char*>(cur + i), 4);
+            i = j;
+            continue;
+        }
+        const int start = i++;
+        while (i < pairs && i - start < kMaxRun && !unchanged(i) &&
+                !(i + 1 < pairs && cur[i + 1] == cur[i])) {
+            ++i;
+        }
+        command(0x00, i - start);
+        out.append(reinterpret_cast<const char*>(cur + start), (i - start) * 4);
+    }
+
+    for (int value : {0x03, 0, 0, 0, 0x40, 0, screen, 0}) {
+        byte(value);
+    }
+    return out;
+}
+
+} // namespace
