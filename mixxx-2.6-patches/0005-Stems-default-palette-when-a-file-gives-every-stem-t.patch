From 72ced48f4940582dcf33657082d957accc2ac6a3 Mon Sep 17 00:00:00 2001
From: Daniel <daniel@teide.tech>
Date: Wed, 30 Sep 2026 18:36:00 +0200
Subject: [PATCH 05/12] Stems: default palette when a file gives every stem the
 same colour

Traktor's built-in stem separation writes #3f007b for every stem, so all
stems rendered the same purple (library, waveforms, controller screens).
Files with deliberately different colours keep theirs.
---
 src/track/steminfoimporter.cpp | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/track/steminfoimporter.cpp b/src/track/steminfoimporter.cpp
index 2f3786c052..518df32a11 100644
--- a/src/track/steminfoimporter.cpp
+++ b/src/track/steminfoimporter.cpp
@@ -202,6 +202,21 @@ QList<StemInfo> StemInfoImporter::importStemInfos(
         stemIdx++;
     }
 
+    // Traktor's built-in stem separation writes one placeholder colour
+    // (#3f007b) for every stem, so all stems render the same purple. Only when
+    // every stem shares one colour, use the default palette instead; files
+    // with deliberately different colours keep theirs.
+    bool allSameColor = stemsList.size() > 1;
+    for (const auto& stemInfo : std::as_const(stemsList)) {
+        allSameColor = allSameColor && stemInfo.getColor() == stemsList.first().getColor();
+    }
+    constexpr int kDefaultColorCount = sizeof(kStemDefaultColor) / sizeof(kStemDefaultColor[0]);
+    if (allSameColor && stemsList.size() <= kDefaultColorCount) {
+        for (int i = 0; i < stemsList.size(); ++i) {
+            stemsList[i] = StemInfo(stemsList[i].getLabel(), kStemDefaultColor[i]);
+        }
+    }
+
     // Extract DSP information
     // TODO(XXX) DSP only contains a limiter and a compressor effect, which
     // Mixxx doesn't have yet. Parse and implement when supported
