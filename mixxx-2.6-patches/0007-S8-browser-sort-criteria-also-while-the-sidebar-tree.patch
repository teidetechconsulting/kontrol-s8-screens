     const int visibleRows = qBound(4, requestedVisibleRows, 9);
     QVariantMap state{
@@ -243,6 +284,9 @@ QVariantMap browserStateOnGuiThread(int requestedVisibleRows) {
                 : path.join(QStringLiteral(" > "));
